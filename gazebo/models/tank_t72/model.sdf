<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="tank_t72">
    <static>true</static>
    <pose>0 0 0.6 0 0 0</pose>
    <link name="body">
      <!-- Hull: 7.0 x 3.6 x 1.2m -->
      <visual name="hull">
        <geometry><box><size>7.0 3.6 1.2</size></box></geometry>
        <material>
          <ambient>0.2 0.25 0.15 1</ambient>
          <diffuse>0.25 0.3 0.18 1</diffuse>
        </material>
      </visual>
      <!-- Turret: 3.0 x 2.4 x 0.8m, centered, offset slightly back -->
      <visual name="turret">
        <pose>-0.3 0 1.0 0 0 0</pose>
        <geometry><box><size>3.0 2.4 0.8</size></box></geometry>
        <material>
          <ambient>0.17 0.22 0.12 1</ambient>
          <diffuse>0.22 0.27 0.15 1</diffuse>
        </material>
      </visual>
      <!-- Gun barrel: 0.3 x 0.3 x 5.0m thin box, extending forward from turret -->
      <visual name="gun_barrel">
        <pose>3.8 0 1.0 0 0 0</pose>
        <geometry><box><size>5.0 0.3 0.3</size></box></geometry>
        <material>
          <ambient>0.15 0.18 0.1 1</ambient>
          <diffuse>0.2 0.23 0.13 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>7.0 3.6 1.2</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
