<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="military_truck">
    <static>true</static>
    <pose>0 0 1.0 0 0 0</pose>
    <link name="body">
      <!-- Cab: 2.5 x 2.4 x 2.0m (front) -->
      <visual name="cab">
        <pose>2.75 0 0 0 0 0</pose>
        <geometry><box><size>2.5 2.4 2.0</size></box></geometry>
        <material>
          <ambient>0.2 0.25 0.15 1</ambient>
          <diffuse>0.25 0.3 0.18 1</diffuse>
        </material>
      </visual>
      <!-- Cargo bed: 5.0 x 2.4 x 1.8m (rear, lighter khaki) -->
