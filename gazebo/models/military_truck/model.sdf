        <geometry><box><size>5.0 2.4 1.8</size></box></geometry>
        <material>
          <ambient>0.35 0.35 0.25 1</ambient>
          <diffuse>0.45 0.43 0.30 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
